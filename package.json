{
  "name": "agent-loop-from-scratch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An LLM agent loop written by hand on the Claude Messages API. It categorizes credit card spending, with code for the math and human approval for the model's proposals.",
  "scripts": {
    "fetch": "tsx src/cli.ts fetch",
    "import": "tsx src/cli.ts import",
    "report": "tsx src/cli.ts report",
    "annual": "tsx src/cli.ts annual",
    "hello": "tsx src/agent/hello.ts",
    "propose": "tsx src/agent/propose.ts",
    "agent": "tsx src/agent/run.ts",
    "approve": "tsx src/agent/approve.ts",
    "interview": "tsx src/study/server.ts",
    "test": "tsx --test src/*.test.ts src/agent/*.test.ts src/study/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "csv-parse": "^7.0.3",
    "israeli-bank-scrapers": "^6.12.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
